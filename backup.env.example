# ============================================================
#  ShuleLinkWeb — Environment Variables for Backup System
#  Copy/paste these into your cPanel .env or backup.sh
# ============================================================

# ——————————————————————————————
# DATABASE (fill from cPanel → MySQL Databases)
# ——————————————————————————————
DB_NAME="shulexpert_school"
DB_USER="shulexpert_user"
DB_PASS="YOUR_DB_PASSWORD_HERE"
DB_HOST="127.0.0.1"

# ——————————————————————————————
# NOTIFICATION EMAIL
# ——————————————————————————————
NOTIFY_EMAIL="hanscode85@gmail.com"

# ——————————————————————————————
# PROJECT PATH ON cPANEL SERVER
# ——————————————————————————————
PROJECT_DIR="$HOME/public_html"
# If your project is in a subfolder e.g. public_html/shulelink:
# PROJECT_DIR="$HOME/public_html/shulelink"

# ——————————————————————————————
# GOOGLE DRIVE (via rclone)
# ——————————————————————————————
GDRIVE_REMOTE="gdrive"
GDRIVE_FOLDER="ShuleLinkBackups"

# ——————————————————————————————
# BACKUP STORAGE PATH
# ——————————————————————————————
BACKUP_DIR="$HOME/backups"

# ——————————————————————————————
# CRON JOB SCHEDULE
# ——————————————————————————————
# Run every day at 2:00 AM:
# 0 2 * * * /bin/bash /home/YOUR_CPANEL_USERNAME/backup.sh >> /home/YOUR_CPANEL_USERNAME/backups/cron.log 2>&1
